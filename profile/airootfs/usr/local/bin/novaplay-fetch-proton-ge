#!/bin/bash
# =====================================================================
#  NovaPlay OS – neuestes GE-Proton herunterladen (mit Prüfsumme)
#
#  novaplay-fetch-proton-ge download <ordner>
#      lädt das GE-Proton-Archiv (x86_64) + Prüfsumme in <ordner> (für den ISO-Bau)
#  novaplay-fetch-proton-ge install  [<archiv.tar.gz>] [<ziel>]
#      entpackt ein Archiv (oder lädt das neueste) nach
#      <ziel> (Standard: /usr/share/steam/compatibilitytools.d)
#
#  Quelle: https://github.com/GloriousEggroll/proton-ge-custom
# =====================================================================
set -euo pipefail

API="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
DEFAULT_TARGET=/usr/share/steam/compatibilitytools.d

# Prüft ein Archiv gegen eine .sha512sum-Datei (vergleicht nur den Hash,
# damit es egal ist, unter welchem Dateinamen die Prüfsumme gespeichert ist).
check_sum() {  # $1 = Archiv, $2 = Prüfsummen-Datei
    local want have
    want=$(grep -F "$(basename "$1")" "$2" | awk '{print $1}' | head -n 1 || true)
    [ -n "$want" ] || want=$(awk 'NF{print $1; exit}' "$2")
    have=$(sha512sum "$1" | awk '{print $1}')
    if [ "$want" != "$have" ]; then
        echo "FEHLER: Prüfsumme von $(basename "$1") stimmt nicht." >&2
        return 1
    fi
    echo "    Prüfsumme OK" >&2
}

fetch_latest() {  # $1 = Zielordner für das Archiv
    local dir="$1" json tag tar_name tar_url sum_url
    mkdir -p "$dir"
    local auth=()
    [ -n "${GITHUB_TOKEN:-}" ] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
    json=$(curl -fsSL --retry 3 "${auth[@]}" "$API")
    read -r tag tar_name tar_url sum_url < <(python3 -c '
import json, sys
d = json.load(sys.stdin)
a = {x["name"]: x["browser_download_url"] for x in d["assets"]}
t = d["tag_name"]
def pick(ext):
    # nur Dateien für normale PCs (x86_64), keine ARM-/aarch64-Archive
    c = [n for n in a if n.endswith(ext) and "aarch64" not in n and "arm" not in n.lower()]
    c.sort(key=lambda n: ("x86_64" not in n, n != t + ext))
    return c[0]
tn = pick(".tar.gz"); sn = pick(".sha512sum")
print(t, tn, a[tn], a[sn])' <<<"$json")
    echo "==> Neueste Version: $tag ($tar_name)" >&2
    if [ -f "$dir/$tar_name" ] && [ -f "$dir/$tar_name.sha512sum" ]; then
        echo "    schon vorhanden" >&2
    else
        curl -fL --retry 3 -o "$dir/$tar_name.part" "$tar_url" >&2
        curl -fsSL --retry 3 -o "$dir/$tar_name.sha512sum" "$sum_url"
        mv "$dir/$tar_name.part" "$dir/$tar_name"
    fi
    check_sum "$dir/$tar_name" "$dir/$tar_name.sha512sum"
    # ältere Archive entfernen
    find "$dir" -maxdepth 1 -name 'GE-Proton*' ! -name "$tar_name" ! -name "$tar_name.sha512sum" -delete
    echo "$dir/$tar_name"
}

install_archive() {  # $1 = Archiv, $2 = Ziel
    local archive="$1" target="$2" name
    if [ -f "$archive.sha512sum" ]; then
        check_sum "$archive" "$archive.sha512sum"
    fi
    # Ordnername direkt aus dem Archiv lesen (nicht aus dem Dateinamen raten)
    name=$({ tar -tzf "$archive" || true; } | awk -F/ 'NR==1{print $1}')
    [ -n "$name" ] || { echo "Archiv ungültig"; exit 1; }
    mkdir -p "$target"
    if [ -f "$target/$name/compatibilitytool.vdf" ]; then
        echo "==> $name ist bereits installiert."
        return 0
    fi
    echo "==> Installiere $name nach $target ..."
    tar -xzf "$archive" -C "$target"
    [ -f "$target/$name/compatibilitytool.vdf" ] || { echo "Archiv ungültig"; exit 1; }
    echo "==> $name ist installiert."
}

case "${1:-}" in
    download)
        [ -n "${2:-}" ] || { echo "Ordner fehlt"; exit 1; }
        fetch_latest "$2" | tail -n 1
        ;;
    install)
        archive="${2:-}"
        target="${3:-$DEFAULT_TARGET}"
        if [ -z "$archive" ]; then
            tmp=$(mktemp -d)
            trap 'rm -rf "$tmp"' EXIT
            archive=$(fetch_latest "$tmp" | tail -n 1)
        fi
        install_archive "$archive" "$target"
        ;;
    *)
        sed -n '3,12p' "$0"
        exit 1
        ;;
esac
